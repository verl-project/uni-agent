+def _add_tokenizer_stop_token_ids(sampling_params: dict, tokenizer: Any) -> None:
+    """Supply EOS ids when the server runs without its tokenizer process."""
+    if sampling_params.get("ignore_eos", False):
+        return
+    eos_ids = getattr(tokenizer, "eos_token_id", None)
+    stop_ids = set(sampling_params.get("stop_token_ids") or ())
+    if isinstance(eos_ids, list | tuple | set):
+        stop_ids.update(eos_ids)
+    elif eos_ids is not None:
+        stop_ids.add(eos_ids)
+    stop_ids.update(getattr(tokenizer, "additional_stop_token_ids", None) or ())
+    if stop_ids:
+        sampling_params["stop_token_ids"] = sorted(stop_ids)
