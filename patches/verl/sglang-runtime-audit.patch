+def _server_args_has_field(server_args_type: type, field_name: str) -> bool:
+    """Check a ServerArgs field across SGLang's config-record implementations."""
+    try:
+        return any(field.name == field_name for field in dataclasses.fields(server_args_type))
+    except TypeError:
+        pass
+
+    try:
+        import msgspec.structs
+
+        return any(field.name == field_name for field in msgspec.structs.fields(server_args_type))
+    except (AttributeError, ImportError, TypeError):
+        annotations = getattr(server_args_type, "__annotations__", {})
+        return field_name in annotations
+
