+def _server_args_has_field(server_args_type: type, field_name: str) -> bool:
+    """Check a ServerArgs field across SGLang's config-record implementations."""
+    try:
+        return any(field.name == field_name for field in dataclasses.fields(server_args_type))
+    except TypeError:
+        pass
+
+    try:
+        import msgspec.structs
+
+        return any(field.name == field_name for field in msgspec.structs.fields(server_args_type))
+    except (AttributeError, ImportError, TypeError):
+        annotations = getattr(server_args_type, "__annotations__", {})
+        return field_name in annotations
+
+
+def _add_tokenizer_stop_token_ids(sampling_params: dict, tokenizer: Any) -> None:
+    """Supply EOS ids when the server runs without its tokenizer process."""
+    if sampling_params.get("ignore_eos", False):
+        return
+    eos_ids = getattr(tokenizer, "eos_token_id", None)
+    stop_ids = set(sampling_params.get("stop_token_ids") or ())
+    if isinstance(eos_ids, list | tuple | set):
+        stop_ids.update(eos_ids)
+    elif eos_ids is not None:
+        stop_ids.add(eos_ids)
+    stop_ids.update(getattr(tokenizer, "additional_stop_token_ids", None) or ())
+    if stop_ids:
+        sampling_params["stop_token_ids"] = sorted(stop_ids)
+
