+class _StandalonePlacementWorker:
+    """Reserve a rollout placement slot without loading weight-sync runtimes.
+
+    Ray actor handles expose ``__ray_call__`` for the node/device discovery used
+    by rollout server launchers. Fixed-weight standalone inference needs that
+    placement lifetime, but it has no trainer weight source and therefore does
+    not need a checkpoint engine or backend-specific server adapter.
+    """
+
+    def __init__(self, replica_rank: int) -> None:
+        self.replica_rank = replica_rank
