+    tokenizer_module = importlib.import_module("sglang.srt.utils.hf_transformers")
+    tokenizer_path = model_config.local_tokenizer_path or model_config.tokenizer_path or model_config.local_path
+    return tokenizer_module.get_tokenizer(tokenizer_path, trust_remote_code=model_config.trust_remote_code)
